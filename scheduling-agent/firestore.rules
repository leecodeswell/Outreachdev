rules_version = '2';

// Security rules for the Outreachdev apps that share this Firebase project:
//   - Scheduling Agent   (collections: users, invites, businesses)
//   - Work Order Manager (collections: wo_users, wo_invites, wo_orgs)
// Paste this whole file into Firebase > Firestore Database > Rules and press Publish.
// It replaces the previous rules for both apps.
//
// Scheduling Agent:
// The owner can read and change everything in their business.
// Employees can only:
//   - read the business name/logo/colors and the published schedule,
//   - read and write their own availability and their own settings,
//   - read cover requests sent to them, and answer them (accept or decline).
// Pairings, hour ranges, preferences and drafts are owner-only.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function biz(bid) { return /databases/$(database)/documents/businesses/$(bid); }
    function isOwner(bid) { return signedIn() && get(biz(bid)).data.ownerUid == request.auth.uid; }
    function memberPath(bid) { return /databases/$(database)/documents/businesses/$(bid)/members/$(request.auth.uid); }
    function isMember(bid) { return signedIn() && exists(memberPath(bid)); }
    function myPid(bid) { return get(memberPath(bid)).data.pid; }

    // ---- billing: the owner can change things during the free trial or once paid ----
    // The trial start is users/{owner}.created, stamped by the server at sign-up and never editable.
    // Accounts made before billing existed have no "created" and stay open.
    // Keep the 14 below the same as trialDays in config.js.
    function billingPath(bid) { return /databases/$(database)/documents/businesses/$(bid)/billing/plan; }
    function paid(bid) { return exists(billingPath(bid)) && get(billingPath(bid)).data.get('paid', false) == true; }
    function inTrial(bid) {
      let c = get(/databases/$(database)/documents/users/$(bid)).data.get('created', null);
      return c == null || request.time < c + duration.value(14, 'd');
    }
    function canWrite(bid) { return isOwner(bid) && (paid(bid) || inTrial(bid)); }

    // Which business a signed-in person belongs to.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && (
        (request.resource.data.role == 'owner' && request.resource.data.bid == uid && request.resource.data.created == request.time) ||
        (request.resource.data.role == 'employee'
          && getAfter(/databases/$(database)/documents/businesses/$(request.resource.data.bid)/members/$(uid)).data.pid == request.resource.data.pid)
      );
      allow update, delete: if false;
    }

    // One-time invite links. Anyone holding the link can look it up (the token is unguessable);
    // nobody can list them.
    match /invites/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if canWrite(request.resource.data.bid) && request.resource.data.usedBy == null;
      allow update: if signedIn()
        && resource.data.usedBy == null
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && existsAfter(/databases/$(database)/documents/businesses/$(resource.data.bid)/members/$(request.auth.uid));
      allow delete: if isOwner(resource.data.bid);
    }

    match /businesses/{bid} {
      allow get: if isOwner(bid) || isMember(bid);
      allow list: if false;
      allow create: if signedIn() && bid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
      allow update: if canWrite(bid) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      // Owner-only: full setup and weekly drafts.
      match /owner/{doc} { allow read: if isOwner(bid); allow write: if canWrite(bid); }
      match /weeks/{wk} { allow read: if isOwner(bid); allow write: if canWrite(bid); }

      // Billing status. The owner can read it; only the server (payment webhook) or you in the
      // Firebase console can change it.
      match /billing/{doc} { allow read: if isOwner(bid); allow write: if false; }

      // The published schedule: the whole team can read it.
      match /published/{wk} {
        allow read: if isOwner(bid) || isMember(bid);
        allow write: if canWrite(bid);
      }

      // Joining: only with a valid, unused invite for this business and person.
      match /members/{uid} {
        allow read: if isOwner(bid) || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.role == 'employee'
          && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.bid == bid
          && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.pid == request.resource.data.pid
          && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.usedBy == null;
        allow update: if false;
        allow delete: if isOwner(bid);
      }

      // Availability: one document per person per week, named "<week>_<person>".
      match /avail/{id} {
        allow read: if isOwner(bid) || (isMember(bid) && resource.data.pid == myPid(bid));
        allow create, update: if isOwner(bid) || (isMember(bid)
          && request.resource.data.pid == myPid(bid)
          && id == request.resource.data.wk + '_' + myPid(bid));
        allow delete: if isOwner(bid);
      }

      // A person's own settings (for now: whether they get cover requests).
      match /prefs/{pid} {
        allow read, write: if isOwner(bid) || (isMember(bid) && pid == myPid(bid));
      }

      // Shift cover requests.
      match /requests/{rid} {
        allow read: if isOwner(bid) || (isMember(bid) && myPid(bid) in resource.data.sent);
        allow create, delete: if canWrite(bid);
        allow update: if canWrite(bid) || (isMember(bid) && validAnswer(bid));
      }

      // An employee may only answer for themselves, only while the request is open.
      // Accepting fills it. Declining may hand the request to the next person in line.
      function validAnswer(bid) {
        let me = myPid(bid);
        let before = resource.data;
        let after = request.resource.data;
        return me in before.sent
          && before.status == 'open'
          && after.diff(before).affectedKeys().hasOnly(['resp', 'status', 'filledBy', 'sent'])
          && after.resp.diff(before.resp).affectedKeys().hasOnly([me])
          && (
            (after.resp[me] == 'accepted' && after.status == 'filled' && after.filledBy == me && after.sent == before.sent)
            || (after.resp[me] == 'declined'
                && after.status in ['open', 'none']
                && after.get('filledBy', null) == before.get('filledBy', null)
                && after.sent.size() >= before.sent.size()
                && after.sent == before.order[0:after.sent.size()])
          );
      }
    }
  
    /* =================================================================
       Work Order Manager (collections starting with wo_)
       Roles: owner, admin, manager, staff, viewer. With "Roles and
       permissions" turned off in the app, every member works as a manager.
       - Everyone in the shop can read work orders, customers and the team list.
       - Shop staff can change only status, hold reason and files, and must
         follow the status steps; closing jobs is for managers unless the
         owner allows staff to close.
       - Every change to a work order must come with a history entry written
         in the same transaction, by the person making the change.
       - History entries can never be edited or deleted.
       - Work orders are stored under their number, so a number can't be
         used twice, and they can't be deleted (cancel them instead).
       - After the free trial, nothing can be changed until the plan is paid.
       ================================================================= */
    function woOrg(org) { return /databases/$(database)/documents/wo_orgs/$(org); }
    function woMemberPath(org) { return /databases/$(database)/documents/wo_orgs/$(org)/members/$(request.auth.uid); }
    function woEventPath(org, id) { return /databases/$(database)/documents/wo_orgs/$(org)/events/$(id); }
    function woOwner(org) { return signedIn() && get(woOrg(org)).data.ownerUid == request.auth.uid; }
    function woMember(org) { return signedIn() && exists(woMemberPath(org)); }
    function woIn(org) { return woOwner(org) || woMember(org); }
    function woSettings(org) { return get(woOrg(org)).data.settings; }
    function woRole(org) {
      return woOwner(org) ? 'owner'
        : !woMember(org) ? 'none'
        : get(woMemberPath(org)).data.role == 'admin' ? 'admin'
        : woSettings(org).features.roles == true ? get(woMemberPath(org)).data.role
        : 'manager';
    }
    function woAdmin(org) { return woRole(org) in ['owner', 'admin']; }
    function woEdit(org) { return woRole(org) in ['owner', 'admin', 'manager']; }
    function woWork(org) { return woRole(org) in ['owner', 'admin', 'manager', 'staff']; }
    // Keep the 14 below the same as trialDays in the work-orders config.js.
    function woPaid(org) { return exists(/databases/$(database)/documents/wo_orgs/$(org)/billing/plan) && get(/databases/$(database)/documents/wo_orgs/$(org)/billing/plan).data.get('paid', false) == true; }
    function woTrial(org) { let c = get(woOrg(org)).data.get('created', null); return c == null || request.time < c + duration.value(14, 'd'); }
    function woActive(org) { return woPaid(org) || woTrial(org); }
    // the person id the app uses for me: "owner" for the owner, otherwise from my membership
    function woMyPid(org) { return woOwner(org) ? 'owner' : get(woMemberPath(org)).data.pid; }
    // the history entry named in lastEvent is new (written in this same request), is about this order, and is mine
    function woLogged(org, num) {
      let ev = request.resource.data.lastEvent;
      return !exists(woEventPath(org, ev))
        && existsAfter(woEventPath(org, ev))
        && getAfter(woEventPath(org, ev)).data.order == num
        && getAfter(woEventPath(org, ev)).data.by == request.auth.uid;
    }
    // shop staff moving a job: closing/reopening only if allowed, and only along the status steps
    function woStaffMove(org) {
      let s = woSettings(org);
      let from = resource.data.status;
      let to = request.resource.data.status;
      return from == to || (
        s.cats.get(to, null) != null
        && (s.closeRole == 'staff' || !(s.cats.get(to, '') in ['done', 'canceled'] || s.cats.get(from, '') in ['done', 'canceled']))
        && (s.features.flow != true || to in s.flow.get(from, []))
      );
    }

    match /wo_users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && (
        (request.resource.data.role == 'owner' && request.resource.data.org == uid && request.resource.data.created == request.time) ||
        (request.resource.data.role == 'member'
          && getAfter(/databases/$(database)/documents/wo_orgs/$(request.resource.data.org)/members/$(uid)).data.pid == request.resource.data.pid)
      );
      // joining another workspace later (or being re-invited) as a member; owners stay owners
      allow update: if signedIn() && request.auth.uid == uid && resource.data.role != 'owner'
        && request.resource.data.role == 'member'
        && getAfter(/databases/$(database)/documents/wo_orgs/$(request.resource.data.org)/members/$(uid)).data.pid == request.resource.data.pid;
      allow delete: if false;
    }

    match /wo_invites/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if woAdmin(request.resource.data.org) && woActive(request.resource.data.org) && request.resource.data.usedBy == null
        && request.resource.data.role in ['admin', 'manager', 'staff', 'viewer'];
      allow update: if signedIn()
        && resource.data.usedBy == null
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && existsAfter(/databases/$(database)/documents/wo_orgs/$(resource.data.org)/members/$(request.auth.uid));
      allow delete: if woAdmin(resource.data.org);
    }

    match /wo_orgs/{org} {
      allow get: if woIn(org);
      allow list: if false;
      allow create: if signedIn() && org == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.created == request.time;
      allow update: if woAdmin(org) && woActive(org)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.created == resource.data.created;
      allow delete: if false;

      match /people/{pid} {
        allow read: if woIn(org);
        allow write: if woAdmin(org) && woActive(org);
      }

      // Joining: only with a valid, unused invite for this workspace, person and role.
      match /members/{uid} {
        allow read: if woAdmin(org) || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/wo_invites/$(request.resource.data.invite)).data.org == org
          && get(/databases/$(database)/documents/wo_invites/$(request.resource.data.invite)).data.pid == request.resource.data.pid
          && get(/databases/$(database)/documents/wo_invites/$(request.resource.data.invite)).data.role == request.resource.data.role
          && get(/databases/$(database)/documents/wo_invites/$(request.resource.data.invite)).data.usedBy == null
          && getAfter(/databases/$(database)/documents/wo_invites/$(request.resource.data.invite)).data.usedBy == request.auth.uid;
        allow update: if woAdmin(org) && woActive(org) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['admin', 'manager', 'staff', 'viewer'];
        allow delete: if woAdmin(org);
      }

      match /customers/{id} {
        allow read: if woIn(org);
        allow create, update: if woEdit(org) && woActive(org);
        allow delete: if woAdmin(org) && woActive(org);
      }

      // Work order number counters: can only go up.
      match /counters/{key} {
        allow read: if woIn(org);
        allow write: if woEdit(org) && woActive(org)
          && request.resource.data.n is int
          && (resource == null || request.resource.data.n >= resource.data.n);
      }

      match /orders/{num} {
        allow read: if woIn(org);
        allow create: if woEdit(org) && woActive(org)
          && request.resource.data.number == num
          && request.resource.data.ver == 1
          && request.resource.data.createdBy == request.auth.uid
          && woLogged(org, num);
        allow update: if woWork(org) && woActive(org)
          && request.resource.data.number == resource.data.number
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.ver == resource.data.ver + 1
          && request.resource.data.lastEvent != resource.data.lastEvent
          && request.resource.data.updatedBy == request.auth.uid
          && woLogged(org, num)
          && (woEdit(org) || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'holdReason', 'files', 'ver', 'updatedAt', 'updatedBy', 'lastEvent', 'closedAt', 'closedBy'])
            && woStaffMove(org)
          ));
        allow delete: if false;
      }

      // Change history: add-only, by the person acting, stamped with the server time.
      match /events/{id} {
        allow read: if woIn(org);
        // A standalone entry can only be a note; any other kind must be the one the order's change points to.
        // Sample data (fictional, with past dates) is only accepted from the owner in the first hour.
        allow create: if woWork(org) && woActive(org)
          && request.resource.data.by == request.auth.uid
          && existsAfter(/databases/$(database)/documents/wo_orgs/$(org)/orders/$(request.resource.data.order))
          && (
            (request.resource.data.get('sample', false) == true && woOwner(org)
              && request.time < get(woOrg(org)).data.created + duration.value(1, 'h'))
            || (
              request.resource.data.at == request.time
              && request.resource.data.pid == woMyPid(org)
              && ((request.resource.data.type == 'note' && request.resource.data.changes.size() == 0)
                || getAfter(/databases/$(database)/documents/wo_orgs/$(org)/orders/$(request.resource.data.order)).data.lastEvent == id)
            )
          );
        allow update, delete: if false;
      }

      // Paid or not: written only by the payment webhook (or you in the Firebase console).
      match /billing/{doc} {
        allow read: if woIn(org);
        allow write: if false;
      }
    }
  }
}
